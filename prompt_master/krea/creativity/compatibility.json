        "illustration",
        "mixed_media"
      ]
    },
    {
      "tag": "halftone",
      "prefer_medium_families": [
        "print",
        "graphic",
        "illustration",
        "mixed_media"
      ]
    },
    {
      "tag": "childrens_book",
      "prefer_style_families": [
        "storybook",
        "illustration"
      ]
    },
    {
      "tag": "anime",
      "prefer_style_families": [
        "anime",
        "illustration"
      ]
    },
    {
      "tag": "fisheye",
      "avoid_lens_tags": [
        "telephoto",
        "compressed"
