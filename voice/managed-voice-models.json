  "cloning": {
    "component": "storytime",
    "upstream": "https://github.com/kuym/storytime",
    "kokoro": "https://huggingface.co/hexgrad/Kokoro-82M",
    "license": "See the LICENSES folder inside the cloning bundle.",
    "note": "Voice cloning is optional and is never needed to use Voice Chat. No pinned Model Chain cloning bundle is published yet, so 'platforms' is deliberately empty and the one-click installer reports that rather than resolving a package at install time: section 78 requires a version, a URL, a byte size and a checksum before anything is downloaded, and inventing one of those would be the trust model this manifest exists to avoid. Prepare a bundle by hand and point Settings at it -- the layout below is what is validated.",
    "supported_systems": [
      "linux"
    ],
    "layout": {
      "executable": [
        "bin/storytime",
        "bin/storytime.exe"
      ],
      "required_files": [
        "assets/kokoro.onnx",
        "assets/tokens.json",
        "assets/spk_encoder.onnx"
      ],
      "required_dirs": [
        "assets/voices"
      ],
      "voice_glob": "assets/voices/*.bin",
      "min_voices": 20
    },
    "command": {
      "note": "Pinned argument arrays for the tested Storytime build, never a shell string. {assets} {reference} {name} {steps} {seed} are substituted with values this extension generated; nothing a browser sent is ever interpolated into an argument.",
      "version_argv": [
        "--version"
      ],
      "script_argv": [
        "clone",
        "--print-script"
      ],
      "clone_argv": [
        "clone",
        "--assets",
        "{assets}",
        "--ref",
        "{reference}",
        "--name",
        "{name}",
        "--steps",
        "{steps}",
        "--seed",
        "{seed}",
        "--backend",
        "onnx"
      ],
      "output": "assets/voices/{name}.bin",
      "checkpoints": [
        "assets/voices/{name}.bin.temp",
        "assets/voices/{name}.bin.temp.json"
      ],
      "default_steps": 2000
    },
    "platforms": []
  },
